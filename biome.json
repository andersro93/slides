{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**",
      "e2e/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!apps/server",
      "!e2e/fixtures",
      "!e2e/test-results",
      "!e2e/playwright-report",
      "!.claude",
      "!**/.omc"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
