{
  "name": "slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "// workspaces": "apps/server is a Go module (apps/server/go.mod) with no package.json, so it is not a workspace. The scripts below cover the frontend and the e2e suite; Go has its own commands (see .mise.toml).",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun run --filter @slides/frontend build",
    "check": "biome check . && bun run typecheck",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "e2e": "cd e2e && bunx playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
}
